+        self.bus.map_device(name, base, size, device)?;
+        Ok(())
+    }
+
+    /// Advances peripheral time without executing CPU instructions (test harness).
+    pub fn advance_time(&mut self, ticks: u64) -> Result<(), String> {
+        self.now = self.now.checked_add(remu_core::SimDuration::from_ticks(ticks))
+            .map_err(|error| error.to_string())?;
+        Ok(())
+    }
