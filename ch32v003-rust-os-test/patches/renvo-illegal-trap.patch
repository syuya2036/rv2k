diff --git a/crates/remu-cpu-riscv/src/core/tests.rs b/crates/remu-cpu-riscv/src/core/tests.rs
index d6ff2d4..c0f8d38 100644
--- a/crates/remu-cpu-riscv/src/core/tests.rs
+++ b/crates/remu-cpu-riscv/src/core/tests.rs
@@ -530,3 +530,16 @@ fn qingke_v2c_zmmul_accepts_multiply_but_rejects_divide() {
         CpuFaultKind::IllegalInstruction
     );
 }
+
+#[test]
+fn qingke_installed_handler_receives_illegal_instruction() {
+    for instruction in [0xffff_ffff, 0x0010_0813, 0x0000_0000] {
+        let (mut cpu, mut bus) = cpu_and_bus(&[instruction], RiscVProfile::ch32v003());
+        cpu.write_csr(CSR_MTVEC, 0x100).unwrap();
+        cpu.step(&mut bus, SimTime::ZERO).unwrap();
+        assert_eq!(cpu.pc, 0x100);
+        assert_eq!(cpu.read_csr(CSR_MEPC).unwrap(), 0);
+        assert_eq!(cpu.read_csr(CSR_MCAUSE).unwrap(), 2);
+        assert_eq!(cpu.read_csr(CSR_MTVAL).unwrap(), instruction);
+    }
+}
